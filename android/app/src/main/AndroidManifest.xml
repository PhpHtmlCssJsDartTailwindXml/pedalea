<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 🔥 AGREGA INTERNET -->
    <uses-permission android:name="android.permission.INTERNET"/>
     <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Notificaciones locales (alertas push de proximidad) en Android 13+ -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Vibración para la alerta de detección de caídas -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Conteo de km en segundo plano (servicio en primer plano con GPS) -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Mensajes de voz en el chat -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Requerido en Android 11+ (API 30+) para que canLaunchUrl() detecte
         apps de teléfono/SMS instaladas (visibilidad de paquetes). Sin esto,
         los botones de llamada de emergencia y SMS al contacto fallan en
         silencio aunque el dispositivo sí tenga esas apps. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:scheme="tel" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="tel" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="sms" />
        </intent>
    </queries>

    <application
        android:label="Pedalea"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">

        <!-- El token de Mapbox se configura en código vía
             MapboxOptions.setAccessToken() (ver lib/core/constants.dart). -->

        <activity
    android:name=".MainActivity"
    android:exported="true"
    android:launchMode="singleTop"
    android:taskAffinity=""
    android:theme="@style/LaunchTheme"
    android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
    android:hardwareAccelerated="true"
    android:enableOnBackInvokedCallback="false"
    android:windowSoftInputMode="adjustResize">

    <meta-data
        android:name="io.flutter.embedding.android.NormalTheme"
        android:resource="@style/NormalTheme"
    />

    <!-- 🔥 APP NORMAL -->
    <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
    </intent-filter>

    <!-- 🔥🔥🔥 ESTO ES LO QUE TE FALTA -->
    <intent-filter>
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.BROWSABLE" />

        <data
            android:scheme="com.pedalea.app"
            android:host="login-callback" />
    </intent-filter>

</activity>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

    </application>

</manifest>